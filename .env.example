# ============================================================
# PlantGuard AI - Environment Configuration
# ============================================================

# Environment: 'production' | 'development' | 'testing'
ENVIRONMENT=production
DEBUG=false

# Host & Port for ASGI Server
HOST=0.0.0.0
PORT=8000

# Cryptographic Secret Key for JWT Signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-secure-random-64-character-hex-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# Database Connection URL (SQLite default or PostgreSQL)
# SQLite: sqlite:///data/plant_disease.db
# PostgreSQL: postgresql://user:password@localhost:5432/plantguard
DATABASE_URL=sqlite:///data/plant_disease.db
DATA_DIR=data

# Allowed Cross-Origin Resource Sharing (CORS) Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Deep Learning Model Configuration
MODEL_FILE=custom_cnn_best.keras
MAX_IMAGE_SIZE_BYTES=12582912
